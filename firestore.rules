rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', null) : null; }
    function restaurantClaim() { return signedIn() ? request.auth.token.get('restaurantId', null) : null; }
    function isSuperAdmin() { return role() == 'SuperAdmin'; }
    function hasAdminMembership(restaurantId) { return signedIn() && role() == 'Admin' && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/admins/$(request.auth.uid)); }
    function isTenantRole(restaurantId, allowedRoles) { return signedIn() && role() in allowedRoles && ((role() == 'Admin' && hasAdminMembership(restaurantId)) || (role() != 'Admin' && restaurantClaim() == restaurantId)); }
    function isTenantAdmin(restaurantId) { return isTenantRole(restaurantId, ['Admin']); }
    function isTenantOperator(restaurantId) { return isTenantRole(restaurantId, ['Admin', 'Cashier', 'Kitchen', 'Delivery', 'Waiter']); }
    function isAnonymousCustomer() { return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous'; }
    function validTimestampFields(data) { return (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp) && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp); }
    function validOptionalString(data, field, maxLength) { return !data.keys().hasAny([field]) || (data.get(field, '') is string && data.get(field, '').size() <= maxLength); }
    function ownsOrder(restaurantId, orderId) { return get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.customerId == request.auth.uid; }
    function validOrder(restaurantId) { return request.resource.data.keys().hasAll(['restaurantId','customerId','items','tableNumber','status','totalAmount']) && request.resource.data.keys().hasOnly(['restaurantId','customerId','items','tableNumber','status','totalAmount','customerName','customerPhone','deliveryAddress','deliveryData','createdAt','updatedAt','driverId','driverName','isClaimed','orderNumber','orderNumberDate','inventoryDeducted','inventoryDeductedAt','isPaid']) && request.resource.data.restaurantId == restaurantId && request.resource.data.customerId == request.auth.uid && request.resource.data.items is list && request.resource.data.items.size() <= 50 && request.resource.data.tableNumber is string && request.resource.data.tableNumber.size() > 0 && request.resource.data.tableNumber.size() <= 32 && request.resource.data.status == 'pending' && request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 && validOptionalString(request.resource.data, 'customerName', 120) && validOptionalString(request.resource.data, 'customerPhone', 40) && validOptionalString(request.resource.data, 'deliveryAddress', 500) && validOptionalString(request.resource.data, 'driverId', 128) && validOptionalString(request.resource.data, 'driverName', 120) && validTimestampFields(request.resource.data); }
    function validOrderTransition(from, to) { return (from == 'pending' && to == 'preparing') || (from == 'preparing' && (to == 'driver_claimed' || to == 'ready_for_payment' || to == 'ready')) || (from == 'driver_claimed' && to == 'ready_for_delivery') || (from == 'ready' && to == 'ready_for_payment') || (from == 'ready_for_payment' && (to == 'ready_for_delivery' || to == 'paid')) || (from == 'ready_for_delivery' && to == 'on_the_way') || (from == 'on_the_way' && to == 'delivered_unpaid') || (from == 'delivered_unpaid' && to == 'paid') || (from == 'paid' && to == 'completed'); }
    function roleMayTransition(restaurantId, from, to) { return isTenantRole(restaurantId, ['Admin']) || (isTenantRole(restaurantId, ['Kitchen']) && ((from == 'pending' && to == 'preparing') || (from == 'preparing' && (to == 'ready' || to == 'ready_for_payment')))) || (isTenantRole(restaurantId, ['Delivery']) && ((from == 'preparing' && to == 'driver_claimed') || (from == 'driver_claimed' && to == 'ready_for_delivery') || (from == 'ready_for_delivery' && to == 'on_the_way') || (from == 'on_the_way' && to == 'delivered_unpaid'))) || (isTenantRole(restaurantId, ['Cashier']) && ((from == 'ready_for_payment' && to == 'paid') || (from == 'delivered_unpaid' && to == 'paid') || (from == 'paid' && to == 'completed'))); }
    function validOrderMutation(restaurantId) { let changed = request.resource.data.diff(resource.data).affectedKeys(); let from = resource.data.status; let to = request.resource.data.status; return changed.hasOnly(['status','driverId','driverName','isClaimed','updatedAt','isPaid']) && validOrderTransition(from, to) && roleMayTransition(restaurantId, from, to) && request.resource.data.restaurantId == resource.data.restaurantId && request.resource.data.customerId == resource.data.customerId && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) && (role() in ['Admin'] || (role() == 'Kitchen' && changed.hasOnly(['status','updatedAt'])) || (role() == 'Cashier' && changed.hasOnly(['status','updatedAt','isPaid']) && request.resource.data.isPaid == true) || (role() == 'Delivery' && ((from == 'preparing' && to == 'driver_claimed' && changed.hasOnly(['status','driverId','driverName','isClaimed','updatedAt']) && request.resource.data.driverId == request.auth.uid && request.resource.data.isClaimed == true && request.resource.data.driverName is string && request.resource.data.driverName.size() <= 120) || (from != 'preparing' && changed.hasOnly(['status','updatedAt']) && request.resource.data.driverId == resource.data.driverId && request.resource.data.driverName == resource.data.driverName && request.resource.data.isClaimed == resource.data.isClaimed))); }
    function validExpense(restaurantId) { return request.resource.data.keys().hasAll(['restaurantId','title','amount','category','expenseDate','createdAt']) && request.resource.data.keys().hasOnly(['restaurantId','title','amount','category','notes','expenseDate','createdAt']) && request.resource.data.restaurantId == restaurantId && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160 && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000 && request.resource.data.category is string && request.resource.data.category.size() <= 100 && request.resource.data.expenseDate is timestamp && request.resource.data.createdAt is timestamp && validOptionalString(request.resource.data, 'notes', 1000); }
    match /restaurants/{restaurantId} {
      allow read: if true; allow create, update, delete: if isSuperAdmin();
      match /settings/{settingId} { allow read: if settingId == 'theme'; allow write: if isTenantAdmin(restaurantId); }
      match /menuItems/{menuItemId} { allow read: if true; allow create, update, delete: if isTenantAdmin(restaurantId); }
      match /categories/{categoryId} { allow read: if true; allow write: if isTenantAdmin(restaurantId); }
      match /qrConfig/{configId} { allow read, write: if isTenantAdmin(restaurantId); }
      match /orders/{orderId} { allow create: if false; allow get, list: if isTenantOperator(restaurantId) || isSuperAdmin() || (isAnonymousCustomer() && resource.data.customerId == request.auth.uid); allow update: if isTenantOperator(restaurantId) && validOrderMutation(restaurantId); allow delete: if isTenantAdmin(restaurantId) || isSuperAdmin(); }
      match /notifications/{notificationId} { allow get, list: if isTenantOperator(restaurantId) || isSuperAdmin(); allow create, update, delete: if false; }
      match /reviews/{reviewId} { allow create: if isAnonymousCustomer() && validReview(restaurantId); allow get, list: if isTenantOperator(restaurantId) || isSuperAdmin(); allow update, delete: if isTenantAdmin(restaurantId) || isSuperAdmin(); }
      match /complaints/{complaintId} { allow create: if isAnonymousCustomer() && validComplaint(restaurantId); allow get, list: if isTenantOperator(restaurantId) || isSuperAdmin(); allow update, delete: if isTenantAdmin(restaurantId) || isSuperAdmin(); }
      match /customers/{customerId} { allow get: if (isAnonymousCustomer() && customerId == request.auth.uid && resource.data.restaurantId == restaurantId) || isTenantRole(restaurantId, ['Admin','Cashier']); allow list: if isTenantRole(restaurantId, ['Admin','Cashier']); allow create, update: if isTenantRole(restaurantId, ['Admin','Cashier']); allow delete: if isTenantAdmin(restaurantId); }
      match /staff/{staffId} { allow get: if isTenantAdmin(restaurantId) || isSuperAdmin() || (isTenantRole(restaurantId, ['Cashier','Kitchen','Delivery']) && resource.data.uid == request.auth.uid) || (isTenantRole(restaurantId, ['Waiter']) && resource.data.uid == request.auth.uid); allow list: if isTenantAdmin(restaurantId) || isSuperAdmin(); allow write: if isTenantAdmin(restaurantId) || isSuperAdmin(); }
      match /inventory/{inventoryId} { allow read, write: if isTenantRole(restaurantId, ['Admin','Kitchen']); }
      match /recipes/{recipeId} { allow read, write: if isTenantRole(restaurantId, ['Admin','Kitchen']); }
      match /waste_log/{entryId} { allow read, write: if isTenantOperator(restaurantId) || isSuperAdmin(); }
      match /wasteLog/{entryId} { allow read, write: if isTenantOperator(restaurantId) || isSuperAdmin(); }
      match /expenses/{expenseId} { allow read: if isTenantAdmin(restaurantId) || isSuperAdmin(); allow create: if (isTenantAdmin(restaurantId) || isSuperAdmin()) && validExpense(restaurantId); allow update: if false; allow delete: if isTenantAdmin(restaurantId) || isSuperAdmin(); }
      match /admins/{adminUid} { allow read: if isSuperAdmin(); allow read: if signedIn() && role() == 'Admin' && adminUid == request.auth.uid; allow create: if isSuperAdmin() && request.resource.data.keys().hasAll(['adminUid', 'createdAt', 'createdBy']) && request.resource.data.keys().hasOnly(['adminUid', 'createdAt', 'createdBy']) && request.resource.data.adminUid == adminUid && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt is timestamp; allow delete: if isSuperAdmin(); allow update: if false; }
      match /orderNumberCounters/{counterId} { allow read, write: if false; }
    }
    match /orders/{orderId} { allow read, write: if false; }
    match /reviews/{reviewId} { allow read, write: if false; }
    match /complaints/{reviewId} { allow read, write: if false; }
    match /staff/{staffId} { allow read, write: if false; }
    match /customers/{customerId} { allow read, write: if false; }
    match /inventory/{inventoryId} { allow read, write: if false; }
    match /recipes/{recipeId} { allow read, write: if false; }
    match /waste_log/{entryId} { allow read, write: if false; }
    match /wasteLog/{entryId} { allow read, write: if false; }
    match /authz_claim_audit/{entryId} { allow read, write: if false; }
    match /admin_membership_audit/{entryId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
