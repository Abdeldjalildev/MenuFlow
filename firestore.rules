rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function hasRole(requiredRole) {
      return signedIn() && role() == requiredRole;
    }

    function isSuperAdmin() {
      return hasRole('SuperAdmin');
    }

    function isRestaurantStaff(restaurantId) {
      return signedIn()
        && role() in ['Admin', 'Cashier', 'Kitchen', 'Delivery']
        && request.auth.token.restaurantId == restaurantId;
    }

    function canManageRestaurant(restaurantId) {
      return isSuperAdmin() || isRestaurantStaff(restaurantId);
    }

    function ownsRestaurantData(data) {
      return data.restaurantId is string && canManageRestaurant(data.restaurantId);
    }

    function preservesTenant(resourceData, requestData) {
      return resourceData.restaurantId == requestData.restaurantId;
    }

    match /restaurants/{restaurantId}/menuItems/{menuItemId} {
      allow read: if true;
      allow create: if canManageRestaurant(restaurantId)
        && request.resource.data.restaurantId == restaurantId;
      allow update, delete: if canManageRestaurant(restaurantId)
        && resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == restaurantId;
    }

    match /restaurants/{restaurantId}/settings/{settingId} {
      allow read: if settingId == 'theme';
      allow write: if canManageRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      // Customer order creation remains open until customer identity is migrated
      // from localStorage IDs to Firebase Auth/anonymous Auth.
      allow create: if request.resource.data.restaurantId is string;
      allow read: if ownsRestaurantData(resource.data);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /staff/{staffId} {
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.token.restaurantId == resource.data.restaurantId);
      allow create: if isSuperAdmin()
        || (signedIn()
          && role() == 'Admin'
          && request.auth.token.restaurantId == request.resource.data.restaurantId);
      allow update: if isSuperAdmin()
        || (signedIn()
          && role() == 'Admin'
          && request.auth.token.restaurantId == resource.data.restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if isSuperAdmin()
        || (signedIn()
          && role() == 'Admin'
          && request.auth.token.restaurantId == resource.data.restaurantId);
    }

    match /customers/{customerId} {
      allow read: if ownsRestaurantData(resource.data);
      allow create: if isSuperAdmin()
        || (signedIn()
          && role() == 'Admin'
          && request.auth.token.restaurantId == request.resource.data.restaurantId);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /inventory/{inventoryId} {
      allow read: if ownsRestaurantData(resource.data);
      allow create: if canManageRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /recipes/{recipeId} {
      allow read: if ownsRestaurantData(resource.data);
      allow create: if canManageRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /reviews/{reviewId} {
      allow create: if request.resource.data.restaurantId is string;
      allow read: if ownsRestaurantData(resource.data);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /complaints/{complaintId} {
      allow create: if request.resource.data.restaurantId is string;
      allow read: if ownsRestaurantData(resource.data);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /waste_log/{entryId} {
      allow read: if ownsRestaurantData(resource.data);
      allow create: if canManageRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /wasteLog/{entryId} {
      allow read: if ownsRestaurantData(resource.data);
      allow create: if canManageRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurantData(resource.data)
        && preservesTenant(resource.data, request.resource.data);
      allow delete: if ownsRestaurantData(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
