{
  "name": "menuflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:rules && npm run test:phase3:gate1 && npm run test:phase3:gate4 && npm run test:phase3:gate5 && npm run test:phase4:gate1 && npm run test:phase4:gates2-3 && node --test tests/auth-authorization-boundary.test.mjs tests/auth-claims-provisioning.test.mjs tests/production-rules-cutover.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-menuflow-rules-test --only firestore \"node --test --test-concurrency=1 tests/firestore-rules.test.mjs tests/firestore-public-write-validation.test.mjs\"",
    "test:phase3:gate1": "node --test tests/phase3-gate1-data-contract.test.mjs",
    "test:phase3:gate4": "node --test tests/phase3-gate4-order-number.test.mjs",
    "test:phase3:gate5": "firebase emulators:exec --project demo-menuflow-phase3-gate5 --only firestore \"node --test --test-concurrency=1 tests/phase3-gate5-regression.test.mjs\"",
    "test:phase4:gate1": "node --test tests/phase4-gate1-ai-secret-boundary.test.mjs",
    "test:phase4:gates2-3": "node --test tests/phase4-gates2-3-ai-boundary.test.mjs",
    "test:phase2:production": "node scripts/phase2-production-verification.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.3.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.28.2",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "packageManager": "npm@10.9.8"
}
