{
  "name": "menuflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:rules && npm run test:phase3:gate1 && npm run test:phase3:gate4 && npm run test:phase3:gate5 && npm run test:phase4:gate1 && npm run test:phase4:gates2-3 && npm run test:phase4:gate4 && npm run test:phase4:gate5 && npm run test:phase5:gate1 && npm run test:phase5:gate2 && npm run test:phase5:gate2:driver && npm run test:phase5:gate3 && npm run test:phase5:gate4 && npm run test:phase5:gate5 && npm run test:phase6:gates1-2 && npm run test:phase6:gates3-4 && npm run test:phase6:gate5 && npm run test:phase7:gate5 && npm run test:phase9:all && npm run test:phase10:all && node --test tests/auth-authorization-boundary.test.mjs tests/auth-claims-provisioning.test.mjs tests/production-rules-cutover.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-menuflow-rules-test --only firestore \"node --test --test-concurrency=1 tests/firestore-rules.test.mjs tests/firestore-public-write-validation.test.mjs\"",
    "test:phase3:gate1": "node --test tests/phase3-gate1-data-contract.test.mjs",
    "test:phase3:gate4": "node --test tests/phase3-gate4-order-number.test.mjs",
    "test:phase3:gate5": "firebase emulators:exec --project demo-menuflow-phase3-gate5 --only firestore \"node --test --test-concurrency=1 tests/phase3-gate5-regression.test.mjs\"",
    "test:phase4:gate1": "node --test tests/phase4-gate1-ai-secret-boundary.test.mjs",
    "test:phase4:gates2-3": "node --test tests/phase4-gates2-3-ai-boundary.test.mjs",
    "test:phase4:gate4": "node --test tests/phase4-gate4-ai-abuse-controls.test.mjs",
    "test:phase4:gate5": "node --test tests/phase4-gate5-ai-security-regression.test.mjs",
    "test:phase5:gate1": "node --test tests/phase5-gate1-domain.test.mjs",
    "test:phase5:gate2": "firebase emulators:exec --project demo-menuflow-phase5-gate2 --only auth,firestore,functions \"node --test --test-concurrency=1 tests/phase5-gate2-order-workflow.test.mjs\"",
    "test:phase5:gate2:driver": "firebase emulators:exec --project demo-menuflow-phase5-gate2-driver --only firestore \"node --test --test-concurrency=1 tests/phase5-gate2-driver-claim.test.mjs\"",
    "test:phase5:gate3": "firebase emulators:exec --project demo-menuflow-phase5-gate3 --only firestore \"node --test --test-concurrency=1 tests/phase5-gate3-customer-firestore.test.mjs\"",
    "test:phase5:gate4": "firebase emulators:exec --project demo-menuflow-phase5-gate4 --only auth,functions \"node --test --test-concurrency=1 tests/phase5-gate4-auth-ai-integration.test.mjs\"",
    "test:phase5:gate5": "node --test tests/phase5-gate5-ci-contract.test.mjs",
    "test:phase6:gates1-2": "node --test tests/phase6-gates1-2-performance.test.mjs",
    "test:phase6:gates3-4": "node --test tests/phase6-gates3-4-performance.test.mjs",
    "test:phase6:gate5": "npm run build && npm run perf:bundle-report && node scripts/phase6-performance-budget.mjs",
    "test:phase7:gate5": "node --test tests/phase7-gate5-quality-barrier.test.mjs",
    "test:phase8:static": "node --test tests/phase8-gate1-domain-model.test.mjs tests/phase8-gate2-admin-membership.test.mjs tests/phase8-gate2-multi-admin.test.mjs tests/phase8-gate3-restaurant-identity.test.mjs tests/phase8-gate4-order-authority.test.mjs tests/phase8-gate5-security-closure.test.mjs",
    "test:phase8:gate5:runtime": "firebase emulators:exec --project demo-menuflow-phase8-security --only firestore \"node --test --test-concurrency=1 tests/phase8-gate5-runtime-security.test.mjs\"",
    "test:phase8:security": "npm run test:phase8:static && npm run test:phase8:gate5:runtime",
    "test:phase9:gate1": "node --test tests/phase9-gate1-order-domain.test.mjs",
    "test:phase9:gate2": "node --test tests/phase9-gate2-server-pricing.test.mjs",
    "test:phase9:gate3": "node --test tests/phase9-gate3-canonical-order-creation.test.mjs",
    "test:phase9:gate4": "node --test tests/phase9-gate4-order-mutation-security.test.mjs",
    "test:phase9:gate5": "node --test tests/phase9-gate5-order-integrity.test.mjs",
    "test:phase9:all": "npm run test:phase9:gate1 && npm run test:phase9:gate2 && npm run test:phase9:gate3 && npm run test:phase9:gate4 && npm run test:phase9:gate5",
    "test:phase10:gate1": "node --test tests/phase10-gate1-waiter-access.test.mjs",
    "test:phase10:gate2": "node --test tests/phase10-gate2-waiter-menu.test.mjs",
    "test:phase10:gate3": "node --test tests/phase10-gate3-waiter-cart-order.test.mjs",
    "test:phase10:gate4": "node --test tests/phase10-gate4-kitchen-integration.test.mjs",
    "test:phase10:all": "npm run test:phase10:gate1 && npm run test:phase10:gate2 && npm run test:phase10:gate3 && npm run test:phase10:gate4",
    "perf:bundle-report": "node scripts/phase6-bundle-report.mjs",
    "perf:budget": "node scripts/phase6-performance-budget.mjs",
    "test:phase2:production": "node scripts/phase2-production-verification.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.3.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.28.2",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "packageManager": "npm@10.9.8"
}
